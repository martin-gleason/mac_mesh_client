#!/bin/sh
# Created: 2026-09-10 15:01 -05:00 · Edited: 2026-10-24 10:09 -05:00
#
# `C4-T6` — the gates, run AFTER the last edit. Gates satisfied in advance and then
# edited past are not gates.
#
# Per-clone: `git config core.hooksPath .githooks`. No commit can carry that setting,
# so a fresh clone is unprotected until somebody runs it.
set -e

echo "pre-commit: gates"

swift build -q --product harness
.build/debug/harness count --check
.build/debug/harness secrets

# Only when the protobufs could have moved — this is the one gate that needs `protoc`.
if git diff --cached --name-only | grep -q -E '^(protos/|sources/meshkitcore/generated/)'; then
    .build/debug/harness protos
fi

# Python, until `F1-T1` is rebuilt in Swift — `radio.py` is the last Python behaviour (`D21`).
uv run python scripts/count_assertions.py --check

echo "pre-commit: pass"
